<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this theme only paints the window graphite before the first frame. -->
    <style name="Theme.SpotifyDash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:colorBackground">@color/graphite</item>
        <item name="android:colorAccent">@color/lime</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
